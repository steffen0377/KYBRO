# /etc/systemd/system/kybro-abos.service
# Erzeugt täglich die Entwurfsrechnungen fälliger Abonnements (gesteuert durch kybro-abos.timer).
[Unit]
Description=KYBRO: Abo-Rechnungen erzeugen
After=mariadb.service

[Service]
Type=oneshot
User=kybro
Group=kybro
WorkingDirectory=/opt/kybro
EnvironmentFile=/opt/kybro/.env
ExecStart=/opt/kybro/venv/bin/python manage.py abo_rechnungen_erzeugen
