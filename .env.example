# Kopiere diese Datei nach .env und passe die Werte an.
# Die Datei .env gehört NIE ins Git-Repository.

# Entwicklung: True. Produktivbetrieb: False.
DEBUG=True

# Geheimer Schlüssel. Erzeugen mit:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Im Produktivbetrieb Pflicht.
SECRET_KEY=

# Kommagetrennte Liste der Hostnamen, unter denen die Anwendung läuft
ALLOWED_HOSTS=localhost,127.0.0.1

# Bei HTTPS hinter einem Reverse-Proxy, z. B. https://kybro.deine-domain.de
CSRF_TRUSTED_ORIGINS=

# Cookies nur über HTTPS senden (Standard: aus im Debug-Modus, sonst an)
# SECURE_COOKIES=True

# Auf True setzen, wenn Apache/nginx den Header X-Forwarded-Proto setzt
# TRUST_PROXY_SSL_HEADER=False

# Datenbank. Ohne DB_NAME wird lokal SQLite (db.sqlite3) verwendet.
# DB_NAME=kybro
# DB_USER=kybro_user
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Lizenzprüfung der Fachmodule (Standard: aus). Mit True sind Module ohne gültige Lizenz gesperrt.
# LIZENZ_PRUEFUNG=False

# Mobile API: Signierschlüssel der Tokens (Standard: aus SECRET_KEY abgeleitet) und Gültigkeit in Tagen
# API_TOKEN_SCHLUESSEL=
# API_TOKEN_GUELTIGKEIT_TAGE=30
